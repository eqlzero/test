function SectionLib:CreateToggleInfiniteJump()
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 42)
    ToggleFrame.BackgroundColor3 = Theme.Secondary
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.Parent = TabPage

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = ToggleFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.AccentDark
    stroke.Transparency = 0.6
    stroke.Thickness = 1.2
    stroke.Parent = ToggleFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.75, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.GothamSemibold
    Label.Text = "Infinite Jump"
    Label.TextColor3 = Theme.Text
    Label.TextSize = 15
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.Parent = ToggleFrame

    local Indicator = Instance.new("Frame")
    Indicator.Size = UDim2.new(0, 28, 0, 28)
    Indicator.Position = UDim2.new(1, -42, 0.5, -14)
    Indicator.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    Indicator.BorderSizePixel = 0
    Indicator.Parent = ToggleFrame

    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = Indicator

    local enabled = false

    local function UpdateVisual()
        if enabled then
            TweenService:Create(Indicator, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {
                BackgroundColor3 = Theme.Accent,
                Position = UDim2.new(1, -42, 0.5, -14)
            }):Play()
        else
            TweenService:Create(Indicator, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {
                BackgroundColor3 = Color3.fromRGB(60, 60, 70)
            }):Play()
        end
    end

    ToggleFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            enabled = not enabled
            UpdateVisual()

            if enabled then
                -- Включаем
                local UserInputService_conn
                UserInputService_conn = UserInputService.JumpRequest:Connect(function()
                    if enabled then
                        player.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
                    end
                end)

                -- Чтобы отключить при выключении
                getgenv().InfiniteJumpConn = UserInputService_conn
            else
                if getgenv().InfiniteJumpConn then
                    getgenv().InfiniteJumpConn:Disconnect()
                    getgenv().InfiniteJumpConn = nil
                end
            end
        end
    end)

    ToggleFrame.MouseEnter:Connect(function()
        TweenService:Create(ToggleFrame, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(45,55,85)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.25}):Play()
    end)

    ToggleFrame.MouseLeave:Connect(function()
        TweenService:Create(ToggleFrame, TweenInfo.new(0.25), {BackgroundColor3 = Theme.Secondary}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.6}):Play()
    end)

    return ToggleFrame
end
