-- Упрощенная функция для отправки данных в Discord через вебхук
local function sendToWebhook(replica)
    if not replica then 
        error("Нет данных для отправки")
        return 
    end
    
    if webhookUrl == "" or webhookUrl == nil then
        error("Нет ссылки на вебхук. Вставьте ссылку в поле Webhook URL")
        return
    end
    
    local coin = (replica.Data and replica.Data.Coin) or 0
    local ornaments = getOrnaments(replica)
    
    -- Собираем статистику по монстрам
    local monsterStats = ""
    for _, info in ipairs(MONSTERS) do
        local pct = getResearchPercent(replica, info.name)
        monsterStats = monsterStats .. string.format("%s: %d%%\n", info.name, pct)
    end
    
    -- Создаем простое сообщение
    local messageContent = string.format(
        "📊 **Статистика игрока**\n\n" ..
        "👤 **Игрок:** %s\n" ..
        "💰 **Ихор (Ichor):** %d\n" ..
        "🎄 **Украшения (Ornaments):** %d\n\n" ..
        "🧬 **Прогресс исследований:**\n%s\n" ..
        "_Overlay Stats by ЖЫРНИИ_",
        LocalPlayer.Name,
        coin,
        ornaments,
        monsterStats
    )
    
    -- Создаем данные для отправки
    local data = {
        content = messageContent,
        username = "Overlay Stats Bot"
    }
    
    local json = HttpService:JSONEncode(data)
    
    -- САМЫЙ ПРОСТОЙ ВАРИАНТ - Пробуем все методы по очереди с pcall
    local success = false
    local errorMessage = ""
    
    -- Вариант 1: syn.request
    if not success and syn and type(syn.request) == "function" then
        local reqSuccess, reqResponse = pcall(function()
            return syn.request({
                Url = webhookUrl,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = json
            })
        end)
        
        if reqSuccess then
            if type(reqResponse) == "table" and (reqResponse.Success or reqResponse.StatusCode == 200 or reqResponse.StatusCode == 204) then
                success = true
            else
                errorMessage = "syn.request вернул ошибку: " .. tostring(reqResponse and reqResponse.StatusCode or "unknown")
            end
        else
            errorMessage = "Ошибка syn.request: " .. tostring(reqResponse)
        end
    end
    
    -- Вариант 2: http_request (для некоторых эксплойтов)
    if not success and http_request and type(http_request) == "function" then
        local reqSuccess, reqResponse = pcall(function()
            return http_request({
                Url = webhookUrl,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = json
            })
        end)
        
        if reqSuccess then
            if type(reqResponse) == "table" and (reqResponse.Success or reqResponse.StatusCode == 200 or reqResponse.StatusCode == 204) then
                success = true
            else
                errorMessage = "http_request вернул ошибку: " .. tostring(reqResponse and reqResponse.StatusCode or "unknown")
            end
        else
            errorMessage = "Ошибка http_request: " .. tostring(reqResponse)
        end
    end
    
    -- Вариант 3: request
    if not success and request and type(request) == "function" then
        local reqSuccess, reqResponse = pcall(function()
            return request({
                Url = webhookUrl,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = json
            })
        end)
        
        if reqSuccess then
            if type(reqResponse) == "table" and (reqResponse.Success or reqResponse.StatusCode == 200 or reqResponse.StatusCode == 204) then
                success = true
            else
                errorMessage = "request вернул ошибку: " .. tostring(reqResponse and reqResponse.StatusCode or "unknown")
            end
        else
            errorMessage = "Ошибка request: " .. tostring(reqResponse)
        end
    end
    
    -- Вариант 4: HttpService:PostAsync (если ничего не работает)
    if not success then
        local reqSuccess, reqResponse = pcall(function()
            return game:GetService("HttpService"):PostAsync(webhookUrl, json, Enum.HttpContentType.ApplicationJson)
        end)
        
        if reqSuccess then
            success = true
        else
            errorMessage = "Ошибка HttpService:PostAsync: " .. tostring(reqResponse)
        end
    end
    
    -- Результат
    if success then
        Rayfield:Notify({
            Title = "✅ Успешно",
            Content = "Статистика отправлена в Discord",
            Duration = 3,
            Image = 4483362458,
        })
        print("[Webhook] Сообщение успешно отправлено")
    else
        error("Не удалось отправить сообщение. Последняя ошибка: " .. errorMessage)
    end
end
