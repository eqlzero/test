local function sendToWebhook(webhookUrl, playerData)
    local message = {
        ["embeds"] = {
            {
                ["title"] = "🚨 Новый инжект!",
                ["description"] = string.format(
                    "**Игрок:** %s\n**UserId:** %d\n**Игра:** %s",
                    playerData.Name, playerData.UserId, game.PlaceId
                ),
                ["color"] = 16711680
            }
        }
    }

    pcall(function()
        game:HttpPost(webhookUrl, game:GetService("HttpService"):JSONEncode(message))
    end)
end

return sendToWebhook
