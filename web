-- Файл на GitHub (web) - ИСПРАВЛЕННАЯ ВЕРСИЯ
-- Этот скрипт ожидает, что вебхук будет в _G.webhookUrl

return function()
    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")
    
    -- Берем вебхук из глобальной переменной
    local webhookUrl = _G.webhookUrl
    
    -- ПРОВЕРКА
    if webhookUrl == nil or webhookUrl == "" then
        error('❌ Ошибка: Вебхук не найден. Убедитесь, что задали _G.webhookUrl перед запуском этой функции.')
    end
    
    local player = Players.LocalPlayer
    
    -- Формируем данные для отправки
    local embedData = {
        ["content"] = "✅ Тест вебхука прошел успешно!",
        ["embeds"] = {{
            ["title"] = "Информация о сессии",
            ["color"] = 65280, -- Зеленый
            ["fields"] = {
                {
                    ["name"] = "👤 Игрок",
                    ["value"] = player.Name,
                    ["inline"] = true
                },
                {
                    ["name"] = "🆔 User ID",
                    ["value"] = tostring(player.UserId),
                    ["inline"] = true
                }
            }
        }}
    }
    
    -- Отправляем запрос
    local success, response = pcall(function()
        local jsonPayload = HttpService:JSONEncode(embedData)
        return HttpService:PostAsync(webhookUrl, jsonPayload, Enum.HttpContentType.ApplicationJson)
    end)
    
    -- Результат
    if success then
        print("✅ Уведомление отправлено в Discord!")
    else
        print("❌ Ошибка: " .. tostring(response))
    end
end
