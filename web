local function sendToDiscord(webhookUrl, message)
    local http = game:GetService("HttpService")

    -- 1. Формируем таблицу с данными
    local data = {
        content = message,  -- Простое текстовое сообщение
        embeds = {{
            title = "Уведомление из Roblox",
            description = message,
            color = 65280,  -- Зелёный цвет
            fields = {
                { name = "Игрок", value = game.Players.LocalPlayer.Name, inline = true },
                { name = "Сервер", value = game.JobId, inline = true }
            }
        }}
    }

    -- 2. Кодируем таблицу в JSON (ОБЯЗАТЕЛЬНО!)
    local jsonData = http:JSONEncode(data)

    -- 3. Отправляем запрос
    local success, response = pcall(function()
        return game:HttpPost(
            webhookUrl,
            jsonData,  -- Передаём JSON, а не таблицу!
            "application/json"
        )
    end)

    if success then
        print("✅ Сообщение отправлено в Discord!")
    else
        warn("❌ Ошибка:", response)
    end
end

